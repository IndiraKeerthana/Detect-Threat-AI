# Optional reputation and geolocation provider credentials. Leave blank to skip.
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
IP_GEOLOCATION_API_KEY=your_ip_geolocation_api_key_here

# DNS and RDAP use the standard library and can be disabled in offline deployments.
THREAT_INTELLIGENCE_DNS_ENABLED=true
THREAT_INTELLIGENCE_RDAP_ENABLED=true
THREAT_INTELLIGENCE_TIMEOUT_SECONDS=2.0
MAX_EMAIL_SIZE_MB=10.0

# Step 7: Autonomous AI Forensic Agent Configuration
AI_AGENT_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_API_KEY=gsk_your_groq_api_key_here
AI_AGENT_MAX_ITERATIONS=3
AI_AGENT_TIMEOUT_SECONDS=60.0

# Database Configuration (Optional / Backend-only)
DATABASE_URL=postgresql://user:password@host:5432/dbname
