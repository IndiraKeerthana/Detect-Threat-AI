# Optional reputation and geolocation provider credentials. Leave blank to skip.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IP_GEOLOCATION_API_KEY=

# DNS and RDAP use the standard library and can be disabled in offline deployments.
THREAT_INTELLIGENCE_DNS_ENABLED=true
THREAT_INTELLIGENCE_RDAP_ENABLED=true
THREAT_INTELLIGENCE_TIMEOUT_SECONDS=2
MAX_EMAIL_SIZE_MB=10

# Step 7: Autonomous AI Forensic Agent (opt-in).
# The provider key is never included in structured investigation context.
AI_AGENT_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
AI_API_KEY=
MAX_AGENT_ITERATIONS=4
AI_AGENT_TIMEOUT_SECONDS=60

# Supabase PostgreSQL Connection String (backend-only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres